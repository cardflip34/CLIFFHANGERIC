# --- Required ---
# Password gate
SITE_PASSWORD=2675riv

# 32+ char random string used to sign the session cookie (HMAC).
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace_with_long_random_hex

# --- Optional ---
# Dropbox API ingest (Path A). If unset, scripts/ingest-dropbox.mjs falls
# back to a manual ZIP/folder path (Path B).
DROPBOX_ACCESS_TOKEN=
DROPBOX_FOLDER_PATH=/Cliffhanger IC

# Inquiry destination (server-side only). Falls back to console log.
INQUIRY_TO_EMAIL=
RESEND_API_KEY=

# Public site URL (used for canonical, og, etc.)
NEXT_PUBLIC_SITE_URL=https://www.CliffhangerIC.com
